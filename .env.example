# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API). .env.local is gitignored and never committed.
#
# Only variables starting with VITE_ are available in the browser code, through
# import.meta.env. Never put the service_role / secret key here: it bypasses
# row-level security, and anything with VITE_ ends up in the public bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Called "publishable key" in newer projects and "anon key" in older ones.
# It's meant to be public. Security comes from row-level security policies.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
